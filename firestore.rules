rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'description', 'photoUrls', 'storagePaths', 'ownerUid', 'ownerEmail', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 6
        && request.resource.data.storagePaths is list
        && request.resource.data.storagePaths.size() <= 6;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
